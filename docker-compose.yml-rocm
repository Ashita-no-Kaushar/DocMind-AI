services:
  docmind:
    build:
      context: .
      dockerfile: Dockerfile
    image: docmind-rocm-local:latest
    container_name: docmind-rocm-app
    restart: unless-stopped
    init: true
    user: "10001:10001"
    labels:
      com.docmind.container.role: application-only
      com.docmind.ollama.runtime: external
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=512m,uid=10001,gid=10001
      - /home/appuser/.cache:rw,noexec,nosuid,nodev,size=2g,uid=10001,gid=10001
    volumes:
      - type: volume
        source: docmind-rocm-data
        target: /home/appuser/data
      - type: volume
        source: docmind-rocm-index-cache
        target: /home/appuser/.index_cache
      - type: volume
        source: docmind-rocm-logs
        target: /home/appuser/logs
    environment:
      DOCMIND_ALLOW_REMOTE_BIND: "true"
      DOCMIND_BIND_ADDRESS: "0.0.0.0"
      DOCMIND_INGESTION_LOCK_PATH: /home/appuser/data/.docmind-ingestion.lock
      DOCMIND_LOG_FILE: /home/appuser/logs/docmind.log
      DOCMIND_R2R_STATE_DIR: /home/appuser/data/r2r
      HOME: /home/appuser
      STREAMLIT_BROWSER_GATHER_USAGE_STATS: "false"
      STREAMLIT_SERVER_ADDRESS: "0.0.0.0"
      XDG_CACHE_HOME: /home/appuser/.cache
    extra_hosts:
      - host.docker.internal:host-gateway
    ports:
      - "127.0.0.1:8501:8501/tcp"
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8501/_stcore/health', timeout=5)"
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    mem_limit: 8g
    cpus: 4.0
    pids_limit: 512
    ulimits:
      nofile:
        soft: 4096
        hard: 8192
    stop_grace_period: 30s

volumes:
  docmind-rocm-data:
  docmind-rocm-index-cache:
  docmind-rocm-logs:
