services:
  docmind:
    build:
      context: .
    image: docmind-local:latest
    container_name: docmind
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    read_only: true
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=512m
      - /home/appuser/.cache:rw,noexec,nosuid,nodev,size=2g
    volumes:
      - docmind-data:/home/appuser/data
      - docmind-index-cache:/home/appuser/.index_cache
    environment:
      DOCMIND_LOG_FILE: /home/appuser/data/docmind.log
    extra_hosts:
      - host.docker.internal:host-gateway
    ports:
      - "8501:8501/tcp"
    mem_limit: 8g
    cpus: 4
    pids_limit: 512

volumes:
  docmind-data:
  docmind-index-cache:
